# ── Server Configuration ──
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/embr3_eswmp
# Signs all admin + portal session tokens. MUST be long and random (≥ 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this logs everyone out — see docs/JWT_SECRET_ROTATION.md.
JWT_SECRET=your-secure-random-secret-here

# Set to "production" on the live server. This strips internal error details
# from 5xx API responses (message-only) instead of leaking err.message/stack.
NODE_ENV=production

# ── Client URL (used in CORS + email links) ──
CLIENT_URL=http://localhost:5173/eswm-pipeline

# ── Email ──────────────────────────────────────────────────────────────────
# Pick ONE of the three options below.
EMAIL_USER=your-email@gmail.com

# Option A — Generic SMTP (any provider, recommended when Gmail auth is unavailable)
#   Outlook / Hotmail (free, no 2FA needed for SMTP):
#     SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#   Yahoo:
#     SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=587
#   Brevo (free 300 emails/day): https://app.brevo.com/settings/keys/smtp
#     SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# SMTP_SECURE=false  # set to true only for port 465

# Option B — Gmail OAuth2 (run node utils/generateGmailToken.js after re-enabling the OAuth client)
# Re-enable the OAuth client: https://console.cloud.google.com/apis/credentials
GMAIL_REFRESH_TOKEN=

# Option C — Gmail App Password (requires 2-Step Verification on the Gmail account)
# Create App Password: https://myaccount.google.com/apppasswords
EMAIL_APP_PASS=your-gmail-app-password

# Google Drive upload storage
# Option A: OAuth client + refresh token. Files are owned by the Google account
# that granted the refresh token. If the OAuth app is in Testing mode, refresh
# tokens can expire; publish the OAuth consent app to Production for live use.
GDRIVE_CLIENT_ID=your-google-oauth-client-id
GDRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GDRIVE_REFRESH_TOKEN=your-google-oauth-refresh-token
GDRIVE_OAUTH_CLIENT_JSON=/home/embr3_eswm/apps/embr3-eswmp/server/secrets/client_secret_xxx.apps.googleusercontent.com.json
GDRIVE_IMAGE_FOLDER_ID=google-drive-folder-id-for-images
GDRIVE_DOCS_FOLDER_ID=google-drive-folder-id-for-documents
GDRIVE_HAULER_LOI_FOLDER_ID=google-drive-folder-id-for-hauler-loi

# Option B: Service account fallback. Share the Drive folders above with the
# service account email, then point this to the JSON key file on the server.
# GDRIVE_SERVICE_ACCOUNT_KEY_FILE=/home/embr3_eswm/apps/embr3-eswmp/server/secrets/embr3-eswm-account.json

# Public API base used by local upload fallback URLs
PUBLIC_API_BASE_PATH=/eswm-pipeline/api


# ── Secret encryption (at-rest config secrets) ──────────────────────────────
# 32-byte key (64 hex chars) used to encrypt config secrets stored in the DB —
# currently the Automation Agent's Anthropic API key fallback. Lives OUTSIDE the
# database so a DB dump alone never yields plaintext secrets. If unset, a key is
# derived from JWT_SECRET (works, but set a dedicated key in production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=

# ── Automation Agent (Anthropic API) ────────────────────────────────────────
# Optional read-only AI monitoring/briefing agent. Uses the OFFICIAL Anthropic
# API only — requires a separate Anthropic Console API key with funded usage
# (https://console.anthropic.com/). This is NOT the Claude.ai subscription and
# must never use a browser login or unofficial endpoint. If no key is set, the
# agent stays disabled: the settings UI works but no model is ever contacted.
#
# NEVER expose this key to the frontend (no VITE_-prefixed copy), never return
# it in an API response, and never log it in full. The server reads it here as
# the PRIMARY source; a UI-entered key is only an encrypted DB fallback.
ANTHROPIC_API_KEY=
# Model is stored in config (DB) and falls back to this env value — set once,
# not hardcoded across files.
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_TIMEOUT_MS=30000
# Master switch — the agent is inert unless this is true AND a key resolves.
AUTOMATION_AGENT_ENABLED=true
# Cost controls: global requests/day and per-user requests/day ceilings.
AUTOMATION_AGENT_DAILY_LIMIT=100
AUTOMATION_AGENT_USER_LIMIT=20

# ── VERA — Virtual Environmental Response Assistant (SLF Portal chatbot) ─────
# VERA is the portal-user-facing help chatbot. It REUSES the Automation Agent's
# provider + API key above (no separate key). When no key is configured or the
# agent is disabled, VERA still answers from its built-in knowledge base
# (rule-based fallback) — so these settings only tune limits, not availability.
#
# Master switch for the chatbot (defaults to true; set to false to hide/disable).
VERA_ENABLED=true
# IP burst limit: chat requests / 15 min / IP (portal-facing, more generous).
VERA_RATE_MAX=120
# Per-user chat requests/day ceiling (0 = unlimited).
VERA_USER_DAILY_LIMIT=200
# Max prior conversation turns sent as context on each chat request.
VERA_MAX_HISTORY=8

# ── Prevention Measures document summaries ──────────────────────────────────
# VERA can summarize an SLF's uploaded Prevention-Measures documents (.pdf/.docx/
# .txt). Documents larger than this many MB are skipped (metadata only). Uses the
# Automation Agent provider above — no summary is produced when no key is set.
PREVENTION_DOC_MAX_MB=15

# ── Gemini (Google) — SAMPLE / INACTIVE future option ───────────────────────
# NOT used by the live Automation Agent (Anthropic remains the active provider).
# Provided only for the standalone sample: server/scripts/testGemini.js.
# Gemini has a genuine FREE tier (no billing) with per-minute/per-day limits.
# Get a free key: https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY blank to keep this feature off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_MS=30000
