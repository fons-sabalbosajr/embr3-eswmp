# ── Server Configuration ──
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/embr3_eswmp
# Signs all admin + portal session tokens. MUST be long and random (≥ 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this logs everyone out — see docs/JWT_SECRET_ROTATION.md.
JWT_SECRET=your-secure-random-secret-here

# Set to "production" on the live server. This strips internal error details
# from 5xx API responses (message-only) instead of leaking err.message/stack.
NODE_ENV=production

# ── Client URL (used in CORS + email links) ──
CLIENT_URL=http://localhost:5173/eswm-pipeline

# ── Email ──────────────────────────────────────────────────────────────────
# Pick ONE of the three options below.
EMAIL_USER=your-email@gmail.com

# Option A — Generic SMTP (any provider, recommended when Gmail auth is unavailable)
#   Outlook / Hotmail (free, no 2FA needed for SMTP):
#     SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#   Yahoo:
#     SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=587
#   Brevo (free 300 emails/day): https://app.brevo.com/settings/keys/smtp
#     SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# SMTP_SECURE=false  # set to true only for port 465

# Option B — Gmail OAuth2 (run node utils/generateGmailToken.js after re-enabling the OAuth client)
# Re-enable the OAuth client: https://console.cloud.google.com/apis/credentials
GMAIL_REFRESH_TOKEN=

# Option C — Gmail App Password (requires 2-Step Verification on the Gmail account)
# Create App Password: https://myaccount.google.com/apppasswords
EMAIL_APP_PASS=your-gmail-app-password

# Google Drive upload storage
# Option A: OAuth client + refresh token. Files are owned by the Google account
# that granted the refresh token. If the OAuth app is in Testing mode, refresh
# tokens can expire; publish the OAuth consent app to Production for live use.
GDRIVE_CLIENT_ID=your-google-oauth-client-id
GDRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GDRIVE_REFRESH_TOKEN=your-google-oauth-refresh-token
GDRIVE_OAUTH_CLIENT_JSON=/home/embr3_eswm/apps/embr3-eswmp/server/secrets/client_secret_xxx.apps.googleusercontent.com.json
GDRIVE_IMAGE_FOLDER_ID=google-drive-folder-id-for-images
GDRIVE_DOCS_FOLDER_ID=google-drive-folder-id-for-documents
GDRIVE_HAULER_LOI_FOLDER_ID=google-drive-folder-id-for-hauler-loi

# Option B: Service account fallback. Share the Drive folders above with the
# service account email, then point this to the JSON key file on the server.
# GDRIVE_SERVICE_ACCOUNT_KEY_FILE=/home/embr3_eswm/apps/embr3-eswmp/server/secrets/embr3-eswm-account.json

# Public API base used by local upload fallback URLs
PUBLIC_API_BASE_PATH=/eswm-pipeline/api

