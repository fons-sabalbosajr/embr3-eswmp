# Windows artifact
nul

# macOS
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Misc
*.local

# Environment & secrets (defense-in-depth; server/ and front-end/ also ignore .env)
.env
.env.*
!.env.example

# Credentials / keys — never commit
*.pem
*.key
credentials.json
service-account.json
secrets/

# Dependencies & build output
node_modules/
dist/

# Internal ops runbook — kept locally, not published in the repo
docs/DEPLOYMENT_GUIDE.md

# Internal operational/credential runbooks — kept locally, not published
docs/GOOGLE_DRIVE_CREDENTIAL_UPDATE.md
docs/JWT_SECRET_ROTATION.md

# Generated developer test workbooks. Build artifacts of
# server/scripts/generateDevTestWorkbook.js — regenerated on demand (the bulk
# upload test suite rebuilds them automatically if missing), and their column
# headers are derived from the portal's own upload definitions, so a committed
# copy would go stale the moment the import format changes. The README beside
# them IS tracked: it documents the test environment and the order of use.
docs/dev-test-data/*.xlsx
